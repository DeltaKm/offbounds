# Usa pnpm come package manager predefinito in Corepack
package-manager=pnpm@10

# Evita modifiche automatiche non volute al file lock
prefer-frozen-lockfile=true

# Usa lockfile v6 (pnpm 10) per performance migliori con molti pacchetti
lockfile-version=6

# L'installazione dev non rimuove i pacchetti di produzione
install-strategy=hoisted

# Migliora le performance nelle CI
frozen-lockfile=false

# Evita problemi fastidiosi con peer dependencies
strict-peer-dependencies=false

# Evita warning per pacchetti non trovati durante lo sviluppo
auto-install-peers=true

# Cache locale più stabile
shared-workspace-lockfile=true

# Evita schifo nelle cartelle containerizzate
shamefully-hoist=false

# Preferisce i symlink nella workspace (più veloce)
node-linker=isolated

# Parallelizza installazioni
child-concurrency=8

# Evita che pnpm cerchi versioni remote durante build offline
offline=false
