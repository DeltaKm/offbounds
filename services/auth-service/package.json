{
  "name": "auth-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate --schema ./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema ./prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.6",
    "@nestjs/core": "^10.3.6",
    "@nestjs/jwt": "^10.0.1",
    "@nestjs/passport": "^10.0.1",
    "@nestjs/platform-express": "^10.3.6",
    "@offbounds/otp-service": "workspace:*",
    "@offbounds/shared-config": "workspace:*",
    "@offbounds/shared-types": "workspace:*",
    "@prisma/client": "5.16.1",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.2.1",
    "@types/express": "^5.0.1",
    "@types/node": "^24.10.1",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "5.16.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
